# ============ SERVER ============
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# ============ ENVIRONMENT MODE ============
# "cloud" = central server
# "local" = branch LAN server (offline)
APP_MODE=cloud
BRANCH_ID=

# ============ DATABASE ============
# Local dev
MONGODB_URI=mongodb://localhost:27017/stockguardpro
# Cloud prod (use Atlas or your cloud Mongo)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stockguardpro

# ============ AUTH ============
JWT_SECRET=replace_with_32_char_minimum_random_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_another_32_char_secret
JWT_REFRESH_EXPIRE=30d

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============ AI (S29 — requires internet) ============
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ============ WHATSAPP (S30 — requires internet) ============
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ============ RECEIPT AUTO-WHATSAPP ============
# Auto-send WhatsApp receipt above this amount
RECEIPT_WHATSAPP_THRESHOLD=50000

# ============ SALARY RULES ============
SALARY_AUTO_GENERATE_DAY=1
ADVANCE_MANAGER_LIMIT=50000
ADVANCE_EMPLOYEE_PERCENT_CAP=50

# ============ SYNC (S61 — offline) ============
SYNC_ENABLED=true
SYNC_INTERVAL_MS=30000
CLOUD_API_URL=
LOCAL_API_URL=http://localhost:5000/api

# ============ LOGGING ============
LOG_LEVEL=info

# ============ SECURITY ============
MAX_EMPLOYERS_PER_COMPANY=5